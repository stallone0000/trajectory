not be negative\")\n        if not callable(clock):\n            raise TypeError(\"clock must be callable\")\n\n        self.max_items = max_items\n        self.clock = clock\n        # key -> (value, expiration time), with the least recently used key\n        # at the beginning of the mapping.\n        self._items = OrderedDict()\n\n    def _remove_expired(self, now):\n        \"\"\"Remove all entries whose expiration has passed.\"\"\"\n        expired = [\n            key\n            for key, (_, expires_at) in self._items.items()\n            if expires_at is not None and expires_at <= now\n        ]\n        for key in expired:\n            del self._items[key]\n\n    def set(self, key, value, ttl=None):\n        \"\"\"Store *value* under *key*, optionally expiring it after *ttl* seconds.\n\n        Setting an existing key replaces its value and TTL and makes it the\n        most recently used entry.\n        \"\"\"\n        if ttl is not None:\n            # Let numeric types supported by the clock raise their normal\n            # TypeError rather than silently accepting an invalid TTL.\n            expires_at = self.clock() + ttl\n        else:\n            expires_at = None\n\n        now = self.clock() if ttl is None else None\n        if now is not None:\n            self._remove_expired(now)\n        else:\n            self._remove_expired(expires_at - ttl)\n\n        self._items.pop(key, None)\n        self._items[key] = (value, expires_at)\n\n        if self.max_items is not None:\n            while len(self._items) > self.max_items:\n                self._items.popitem(last=False)\n\n    def get(self, key, default=None):\n        \"\"\"Return the value for *key*, or *default* if absent or expired.\"\"\"\n        item = self._items.get(key)\n        if item is None:\n            return default\n\n        value, expires_at = item\n        if expires_at is not None and expires_at <= self.clock():\n            del self._items[key]\n            return default\n\n        self._items.move_to_end(key)\n        return value\n\n    def delete(self, key):\n        \"\"\"Delete *key* and return whether an entry was removed.\"\"\"\n        return self._items.pop(key, None) is not None\n\n    def __len__(self):\n        \"\"\"Return the number of entries currently held.\n\n        Expired entries are discarded before calculating the length.\n        \"\"\"\n        self._remove_expired(self.clock())\n        return len(self._items)\n\n\n# These aliases make the implementation convenient to use under either of the\n# common names for a small key-value store, while TinyKV remains the primary API.\nKeyValueStore = TinyKV\nTinyKeyValueStore = TinyKV\n\n__all__ = [\"TinyKV\", \"KeyValueStore\", \"TinyKeyValueStore\"]\n"}}],"api":"openai-responses","provider":"paratera-openai","model":"GPT-6.1-Terra","usage":{"input":497,"output":1698,"cacheRead":1152,"cacheWrite":0,"reasoning":796,"totalTokens":3347,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"stopReason":"toolUse","timestamp":1794248785153,"responseId":"resp_SF_B0oyURhoSLGmROLDMorxzIguuLY6uz6e7KAskv18-npGfYlUmV1gHu3nF0knNV5GlKf9OkOi0mKXN-6GHglvkPY1QXW4z-ejGvTG3B0_07EmSJUGHF2JpS9Y1kVJqCCm7Xm9Ed58cRhLihCSMnSYN5_U_PPLh-LGo_1dNwSymCHh4qq7SKG0mArPy5GkHQ-krH3-8jfkHJIVUM_41jooSPWyIotPfbQUP_a_s8SBWGkcEkDGJlJ3hdkRsiEOqXMWJKlfGSbqc3UibRVLqY0nMIH5etOkEz1UH_bi_z244FE6siyDMkoTRvAhUkjZEVGobN2cqZ8IoSyqAUe-r7HJLl0b-ODaMKljUuPkvoQlXzhDEAKsGlmzt7akoGast6nHEUDxUYXf9QHgJF69LeHMOFEbgtV5QmxAvuj-0qe4jWJnIfqQLVr9Blua623hT2wotwkO0ETUebK7yM5R8POw07_3egQ==","rawStopReason":"completed","durationMs":54992,"thinkingLevel":"high"}}